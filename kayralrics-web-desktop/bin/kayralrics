#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE="kayralrics.service"
URL="http://127.0.0.1:1337/vnc.html?host=127.0.0.1&port=1337&path=websockify&autoconnect=true"

wait_for_web() {
    for _ in {1..40}; do
        if ss -H -ltn 2>/dev/null | awk '{print $4}' | grep -Eq '(^|:)1337$'; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

case "${1:-open}" in
    start)
        systemctl --user start "$SERVICE"
        printf 'Kayralrics is starting.\n'
        ;;
    stop)
        systemctl --user stop "$SERVICE"
        printf 'Kayralrics stopped.\n'
        ;;
    restart)
        systemctl --user restart "$SERVICE"
        printf 'Kayralrics restarted.\n'
        ;;
    status)
        systemctl --user status "$SERVICE" --no-pager -l
        ;;
    logs)
        journalctl --user -u "$SERVICE" -f
        ;;
    open)
        systemctl --user start "$SERVICE"
        if wait_for_web; then
            xdg-open "$URL" >/dev/null 2>&1 &
            printf 'Opening %s\n' "$URL"
        else
            printf 'Web desktop did not start. Check: journalctl --user -u %s -n 80\n' "$SERVICE" >&2
            exit 1
        fi
        ;;
    *)
        printf 'Usage: kayralrics [open|start|stop|restart|status|logs]\n' >&2
        exit 2
        ;;
esac
